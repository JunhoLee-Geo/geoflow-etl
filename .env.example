# Set a local development password; never commit the resulting .env file.
POSTGRES_PASSWORD=
# PowerShell: set $env:GEOFLOW_DATABASE_URL explicitly; the CLI does not load .env.
GEOFLOW_DATABASE_URL=
GEOFLOW_TEST_DATABASE_URL=

POSTGRES_DB=geoflow
POSTGRES_USER=geoflow
POSTGRES_PORT=5432

# Monitoring uses a separate SELECT-only role; never reuse the writer URL.
GEOFLOW_API_DATABASE_URL=
GEOFLOW_API_URL=http://127.0.0.1:8000
GEOFLOW_CORS_ORIGINS=
GEOFLOW_PREVIEW_DATASETS=

# Container migration creates a dedicated SELECT-only monitoring login.
GEOFLOW_MONITOR_PASSWORD=
